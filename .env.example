# Copia este archivo a apps/web/.env.local. El arranque falla nombrando cada variable exigida que falte (RS-NF-014).

# Exigidas hoy. En local: DATABASE_URL=file:local.db, sin token, y `pnpm --filter @ghycs/web db:migrate`.
DATABASE_URL=libsql://ghycs-usuario.turso.io
DATABASE_AUTH_TOKEN=
# FreeBusy del calendario del gestor (ADR-0004): cliente OAuth de Google y refresh token con el alcance
# calendar.freebusy. GOOGLE_CALENDAR_ID vacío consulta el calendario principal de la cuenta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Aún sin consumidor: se exigirán cuando llegue el adaptador que las lea.
ADMIN_EMAIL=gestor@ejemplo.co
ADMIN_PASSWORD_HASH=
IP_HASH_SALT=
RESEND_API_KEY=
CORREO_REMITENTE=citas@ejemplo.co
CORREO_GESTOR=gestor@ejemplo.co

# Horario base de atención (RS-F-001). Tienen valor por defecto: solo defínelas para cambiarlo.
HORARIO_DIAS=1,2,3,4,5
HORARIO_FRANJAS=08:00-12:00,14:00-17:00
CITA_DURACION_MINUTOS=45
ANTICIPACION_MINIMA_HORAS=24
HORIZONTE_MAXIMO_DIAS=30
