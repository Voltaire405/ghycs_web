# Copia este archivo a apps/web/.env.local. El arranque falla nombrando cada variable exigida que falte (RS-NF-014).

# Exigidas hoy. En local: DATABASE_URL=file:local.db, sin token, y `pnpm --filter @ghycs/web db:migrate`.
DATABASE_URL=libsql://ghycs-usuario.turso.io
DATABASE_AUTH_TOKEN=
# Cliente OAuth de Google: FreeBusy del calendario del gestor (ADR-0004) y su inicio de sesión (ADR-0006).
# El refresh token lleva los alcances calendar.freebusy y calendar.events. GOOGLE_CALENDAR_ID vacío usa el calendario principal: ahí se lee la ocupación y se crean las citas.
# El cliente necesita la URI de redireccionamiento <BETTER_AUTH_URL>/api/auth/callback/google.
# Para una cuenta de prueba (local y secretos de CI): `scripts/credenciales-google.sh`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Acceso del gestor (ADR-0006). Secreto de 32+ caracteres: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Lista de acceso: correos de los socios separados por coma. No hay roles (RC-5).
CORREOS_SOCIOS=gestor@ejemplo.co

# Confirmación al prospecto por Resend (RP-F-021). El remitente debe ser de un dominio verificado en Resend;
# sin dominio propio, `GHYCS <onboarding@resend.dev>` solo entrega al correo de la cuenta de Resend.
RESEND_API_KEY=
CORREO_REMITENTE=GHYCS <citas@ejemplo.co>

# Asistente público (RP-F-017). Opcional: sin clave, la burbuja avisa que no está disponible.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Aún sin consumidor: se exigirá cuando llegue el aviso al gestor.
CORREO_GESTOR=gestor@ejemplo.co

# Horario base de atención (RS-F-001). Tienen valor por defecto: solo defínelas para cambiarlo.
HORARIO_DIAS=1,2,3,4,5
HORARIO_FRANJAS=08:00-12:00,14:00-17:00
CITA_DURACION_MINUTOS=45
ANTICIPACION_MINIMA_HORAS=24
HORIZONTE_MAXIMO_DIAS=30
